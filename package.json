{
  "name": "go-history",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:local": "node --import tsx scripts/setup-local.ts",
    "services": "docker compose up -d --wait",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "admin": "node --env-file=.env --import tsx scripts/admin.ts",
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file=.env --import tsx --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production node --env-file=.env --import tsx server/index.ts",
    "test": "node --env-file=.env --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.28",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.4.0"
  },
  "engines": { "node": ">=22.12.0" }
}
